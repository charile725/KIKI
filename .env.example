# Supabase 測試專案（不要填正式專案；不需要 service_role）。
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# 後端專用：讓 Demo 註冊後立即登入、不寄驗證信。不要加 VITE_ 前綴。
SUPABASE_SECRET_KEY=
# 正式 AI 服務的秘密只留在 Node.js 後端，絕對不要使用 VITE_ 前綴。
RECOMMENDATION_MODE=demo
TRYON_MODE=demo
AI_RECOMMENDATION_URL=
AI_RECOMMENDATION_KEY=
AI_TRYON_URL=
AI_TRYON_KEY=
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
